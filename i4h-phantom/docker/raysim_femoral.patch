+static const aiMesh* assimp_mesh_of(const std::shared_ptr<Assimp::Importer>& importer) {
+  auto scene = importer->GetScene();
+  return scene->mMeshes[scene->mRootNode->mChildren[0]->mMeshes[0]];
+}
+
+std::vector<float> Mesh::get_vertices() const {
+  auto mesh = assimp_mesh_of(importer_);
+  std::vector<float> out(mesh->mNumVertices * 3);
+  for (unsigned int i = 0; i < mesh->mNumVertices; ++i) {
+    out[i * 3 + 0] = mesh->mVertices[i].x;
+    out[i * 3 + 1] = mesh->mVertices[i].y;
+    out[i * 3 + 2] = mesh->mVertices[i].z;
+  }
+  return out;
+}
+
+std::vector<float> Mesh::get_normals() const {
+  auto mesh = assimp_mesh_of(importer_);
+  std::vector<float> out(mesh->mNumVertices * 3);
+  for (unsigned int i = 0; i < mesh->mNumVertices; ++i) {
+    out[i * 3 + 0] = mesh->mNormals[i].x;
+    out[i * 3 + 1] = mesh->mNormals[i].y;
+    out[i * 3 + 2] = mesh->mNormals[i].z;
+  }
+  return out;
+}
+
+std::vector<uint32_t> Mesh::get_indices() const {
+  auto mesh = assimp_mesh_of(importer_);
+  std::vector<uint32_t> out(mesh->mNumFaces * 3);
+  for (unsigned int f = 0; f < mesh->mNumFaces; ++f) {
+    out[f * 3 + 0] = mesh->mFaces[f].mIndices[0];
+    out[f * 3 + 1] = mesh->mFaces[f].mIndices[1];
+    out[f * 3 + 2] = mesh->mFaces[f].mIndices[2];
+  }
+  return out;
+}
+
+void Mesh::set_vertices(const float* vertices, size_t num_vertices, cudaStream_t stream) {
+  if (!cuda_vertex_buffer_) {
+    throw std::runtime_error("Mesh::set_vertices: build() has not run yet (add the mesh to a World "
+                             "and create the simulator first)");
+  }
+  if (num_vertices != num_vertices_) {
+    throw std::runtime_error(fmt::format(
+        "Mesh::set_vertices: vertex count {} does not match the mesh's {}", num_vertices,
+        num_vertices_));
+  }
+  cuda_vertex_buffer_->upload(vertices, stream);
+  // the caller's host buffer may be freed on return: finish the copy before returning
+  CUDA_CHECK(cudaStreamSynchronize(stream));
+}
+
+void Mesh::set_vertices_device(const void* d_vertices, size_t num_vertices, cudaStream_t stream) {
+  if (!cuda_vertex_buffer_) { throw std::runtime_error("Mesh::set_vertices_device: build() has not run yet"); }
+  if (num_vertices != num_vertices_) {
+    throw std::runtime_error(fmt::format("Mesh::set_vertices_device: vertex count {} does not match the mesh's {}",
+                                         num_vertices, num_vertices_));
+  }
+  CUDA_CHECK(cudaMemcpyAsync(cuda_vertex_buffer_->get_ptr(stream), d_vertices, num_vertices * 3 * sizeof(float),
+                             cudaMemcpyDeviceToDevice, stream));
+  CUDA_CHECK(cudaStreamSynchronize(stream));
+}
+
+void Mesh::set_normals_device(const void* d_normals, size_t num_vertices, cudaStream_t stream) {
+  if (!cuda_normal_buffer_) { throw std::runtime_error("Mesh::set_normals_device: build() has not run yet"); }
+  if (num_vertices != num_vertices_) {
+    throw std::runtime_error(fmt::format("Mesh::set_normals_device: vertex count {} does not match the mesh's {}",
+                                         num_vertices, num_vertices_));
+  }
+  CUDA_CHECK(cudaMemcpyAsync(cuda_normal_buffer_->get_ptr(stream), d_normals, num_vertices * 3 * sizeof(float),
+                             cudaMemcpyDeviceToDevice, stream));
+  CUDA_CHECK(cudaStreamSynchronize(stream));
+}
+
+void Mesh::set_normals(const float* normals, size_t num_vertices, cudaStream_t stream) {
+  if (!cuda_normal_buffer_) { throw std::runtime_error("Mesh::set_normals: build() has not run yet"); }
+  if (num_vertices != num_vertices_) {
+    throw std::runtime_error(fmt::format(
+        "Mesh::set_normals: vertex count {} does not match the mesh's {}", num_vertices,
+        num_vertices_));
+  }
+  cuda_normal_buffer_->upload(normals, stream);
+  CUDA_CHECK(cudaStreamSynchronize(stream));
+}
+
 }  // namespace raysim
